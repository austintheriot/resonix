{
  "name": "resonix-web-js",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "description": "TypeScript glue code & wrappers for running Resonix ergonomically on the web",
  "exports": {
    ".": "./dist/index.mjs",
    "./ResonixProcessor.worklet": "./dist/ResonixProcessor.worklet.mjs",
    "./package.json": "./package.json",
    "./resonix.wasm": "./dist/resonix.wasm"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "check": "yarn tsc -p src/worklet --noEmit && yarn tsc --noEmit",
    "dev": "tsdown --watch ../resonix/dist/",
    "build": "tsdown"
  },
  "dependencies": {
    "resonix": "0.0.1"
  },
  "devDependencies": {
    "@types/audioworklet": "^0.0.97",
    "@types/node": "^25.5.0",
    "tsdown": "^0.21.7",
    "typescript": "^6.0.2"
  }
}
