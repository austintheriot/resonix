{
  "name": "resonix-web-js",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "description": "Resonix TypeScript glue code for running on web",
  "exports": {
    ".": "./dist/index.mjs",
    "./resonixProcessor": "./dist/resonixProcessor.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "check": "yarn tsc --noEmit && yarn tsc -p tsconfig.worklet.json --noEmit",
    "dev": "tsdown --watch",
    "build": "tsdown"
  },
  "dependencies": {
    "resonix": "0.0.1"
  },
  "devDependencies": {
    "@types/audioworklet": "^0.0.97",
    "@types/node": "^25.5.0",
    "tsdown": "^0.21.7",
    "typescript": "^6.0.2"
  }
}
